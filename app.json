{
  "expo": {
    "name": "SeLECT",
    "slug": "select",
    "owner": "galovic",
    "version": "4.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "select",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/cc84318e-ccd7-4b4b-9ceb-a65c4361ea7b"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sk.sasak.select",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "sk.sasak.select"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "cc84318e-ccd7-4b4b-9ceb-a65c4361ea7b"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#91ac09",
          "ios": {
            "image": "./assets/images/splash.png",
            "imageWidth": 870,
            "resizeMode": "contain",
            "backgroundColor": "#91ac09"
          }
        }
      ]
    ]
  }
}
